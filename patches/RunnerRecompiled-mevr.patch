+/* Entry hooks (lift.py ENTRY_HOOKS): nonzero once a VR module registered one; rt_entry_hook returns
+   1 when the hook ran the call (the function then returns at once, esp/eax already set). */
+extern volatile int rt_entry_hooks_on;
