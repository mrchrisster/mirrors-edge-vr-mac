 #define ARG(i) rt_arg(ctx, i)
 #define D3D_VT(obj) (*(void ***)(obj))
+/* VR interposer (mevr): a loaded VR module may replace any method slot of any interface. The
+   replacement has the method's own host signature and calls the original through D3D_VT(self).
+   NULL = not replaced. This is the recomp's equivalent of the Windows mod's vtable patching. */
+#define D3D_SLOT_MAX 128
+extern void *d3d_slot_override[D3D_IFACE_COUNT][D3D_SLOT_MAX];
+#define D3D_SLOT(obj, iface, idx) (d3d_slot_override[iface][idx] ? d3d_slot_override[iface][idx] : D3D_VT(obj)[idx])
+void d3d_vr_device_created(void *host_device, void *present_params); /* rt_d3d9.c -> mevr, after CreateDevice */
 #define D3D_PTR(a) ((a) ? rt_ptr(a) : NULL)
 
 void *d3d_host(uint32_t proxy);
