+
+/* ---- VR interposer (mevr, see rt_vr.h) ---- */
+#include "rt_vr.h"
+void *d3d_slot_override[D3D_IFACE_COUNT][D3D_SLOT_MAX];
+static const MevrModule *vr_mod;
+
+static void vr_log(const char *msg) { rt_log("mevr: %s", msg); }
+static void *vr_guest_ptr(uint32_t a) { return a ? rt_ptr(a) : NULL; }
+static int vr_guest_ok(uint32_t a) { return a >= 0x10000 && (rt_vm_is_committed(a) || rt_module_at(a)); }
+
+uint32_t host_pad_get(uint32_t index, uint8_t state[16]);
+
+/* ---- entry hooks and guest calls for the VR module ---- */
+volatile int rt_entry_hooks_on;
+static __thread uint32_t vr_bypass;   /* the next entry of this address runs the original */
+
+int rt_entry_hook(X86Ctx *ctx, uint32_t addr)
+{
+    if (vr_bypass == addr) { vr_bypass = 0; return 0; }
+    return vr_mod && vr_mod->entry_hook ? vr_mod->entry_hook(ctx, addr) : 0;
+}
+static void *vr_thread_ctx(void) { RtThread *t = rt_thread_self(); return t ? &t->ctx : NULL; }
+static void vr_enable_entry_hooks(int on) { rt_entry_hooks_on = on; rt_log("mevr: entry hooks %s", on ? "on" : "off"); }
+static void vr_call_original(void *ctx, uint32_t addr)
+{
+    X86Ctx *c = ctx ? (X86Ctx *)ctx : (X86Ctx *)vr_thread_ctx();
+    if (!c) return;
+    vr_bypass = addr;
+    x86_dispatch(c, addr);
+    vr_bypass = 0;
+}
+static uint32_t vr_call_guest(void *ctx, uint32_t fn, uint32_t ecx, int nargs, const uint32_t *args)
+{
+    X86Ctx *c = ctx ? (X86Ctx *)ctx : (X86Ctx *)vr_thread_ctx();
+    if (!c) return 0;
+    /* eax/ecx/edx are the caller's scratch registers; everything else the callee preserves. */
+    uint32_t saved_ecx = c->ecx, saved_edx = c->edx;
+    c->ecx = ecx;
+    uint32_t r = rt_call(c, fn, nargs, args);
+    c->ecx = saved_ecx; c->edx = saved_edx;
+    return r;
+}
+static uint32_t vr_guest_alloc(uint32_t size) { return rt_heap_alloc(size, 1); }
+static void vr_guest_free(uint32_t addr) { if (addr) rt_heap_free(addr); }
+
+static const MevrHostApi vr_api = {
+    MEVR_API_VERSION,
+    vr_log,
+    &d3d_slot_override[0][0], D3D_IFACE_COUNT, D3D_SLOT_MAX,
+    vr_guest_ptr, vr_guest_ok,
+    host_pad_get,
+    vr_thread_ctx, vr_enable_entry_hooks, vr_call_original, vr_call_guest, vr_guest_alloc, vr_guest_free,
+};
+
+int d3d_vr_audio(const int16_t *lr, uint32_t frames, uint32_t rate)
+{
+    return vr_mod && vr_mod->audio_mixed ? vr_mod->audio_mixed(lr, frames, rate) : 0;
+}
+
+uint32_t d3d_vr_pad_get(uint32_t index, uint8_t state[16])
+{
+    if (vr_mod && vr_mod->pad_get) return vr_mod->pad_get(index, state);
+    return host_pad_get(index, state);
+}
+
+void d3d_vr_attach(const MevrModule *(*attach)(const MevrHostApi *))
+{
+    vr_mod = attach ? attach(&vr_api) : NULL;
+    rt_log("mevr: VR module %s", vr_mod ? "attached" : "refused to attach");
+}
+
+void d3d_vr_d3d9_created(void *host_d3d9)
+{
+    if (vr_mod && vr_mod->d3d9_created) vr_mod->d3d9_created(host_d3d9);
+}
+
+void d3d_vr_device_created(void *host_device, void *present_params)
+{
+    (void)present_params;
+    if (vr_mod && vr_mod->device_created) vr_mod->device_created(host_device);
+}
