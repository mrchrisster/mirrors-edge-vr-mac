diff --git a/pc/runtime/rt_vr.h b/pc/runtime/rt_vr.h
new file mode 100644
index 0000000..0f4a096
--- /dev/null
+++ b/pc/runtime/rt_vr.h
@@ -0,0 +1,68 @@
+/* C ABI between the runtime and an optional VR module (libmevr.dylib, ME_VR=<path>).
+
+   The runtime loads the module before DXVK, calls mevr_attach() with this host API, and then
+   calls back into the module at the points listed in MevrModule. The module intercepts
+   Direct3D 9 by filling slots of the override table (rt_d3d9.h: d3d_slot_override), the
+   recomp's equivalent of patching a COM vtable: a replacement has the method's host signature
+   and calls the original through the object's own vtable. Guest memory is reached through
+   guest_ptr (the game's 32-bit addresses are unchanged by the lift). */
+#ifndef RT_VR_H
+#define RT_VR_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MEVR_API_VERSION 4
+
+typedef struct MevrHostApi {
+    uint32_t version;
+    void (*log)(const char *msg);
+    /* d3d_slot_override as a flat array: slot_override[iface * slot_max + index] */
+    void **slot_override;
+    uint32_t iface_count, slot_max;
+    void *(*guest_ptr)(uint32_t guest_address);   /* host pointer for a guest address (NULL for 0) */
+    int (*guest_ok)(uint32_t guest_address);      /* address is committed guest memory or a module */
+    uint32_t (*pad_real)(uint32_t index, uint8_t state[16]); /* the physical pad as XInputGetState sees it */
+    /* Game code. ctx is the calling guest thread's X86Ctx (NULL = this thread's own). */
+    void *(*thread_ctx)(void);                      /* this thread's X86Ctx, NULL off guest threads */
+    void (*enable_entry_hooks)(int on);             /* lift.py ENTRY_HOOKS start asking entry_hook */
+    /* Runs the function at addr for the call now at its entry (inside entry_hook: esp at the
+       return address, arguments above it), skipping the entry hook once; esp/eax as on return. */
+    void (*call_original)(void *ctx, uint32_t addr);
+    /* Calls game code: thiscall when ecx != 0, stdcall arguments; returns eax. */
+    uint32_t (*call_guest)(void *ctx, uint32_t fn, uint32_t ecx, int nargs, const uint32_t *args);
+    uint32_t (*guest_alloc)(uint32_t size);         /* guest heap memory (zeroed), for call arguments */
+    void (*guest_free)(uint32_t addr);
+} MevrHostApi;
+
+typedef struct MevrModule {
+    uint32_t version;
+    void (*device_created)(void *host_device);    /* IDirect3DDevice9 (DXVK) just created */
+    void (*d3d9_created)(void *host_d3d9);        /* IDirect3D9 (DXVK) just created (twice per start) */
+    /* XInputGetState for the game (XINPUT_STATE, 16 bytes); NULL = the physical pad only */
+    uint32_t (*pad_get)(uint32_t index, uint8_t state[16]);
+    /* An ENTRY_HOOKS function was called: return 1 when the call was handled (call_original
+       or an emulated return), 0 to let the function run normally. */
+    int (*entry_hook)(void *ctx, uint32_t addr);
+    /* The game's final audio mix (interleaved stereo s16 at rate), every host audio callback.
+       Return nonzero to silence the local output (the module plays it elsewhere, e.g. the headset). */
+    int (*audio_mixed)(const int16_t *lr, uint32_t frames, uint32_t rate);
+} MevrModule;
+
+/* Exported by the module. */
+typedef const MevrModule *(*MevrAttachFn)(const MevrHostApi *api);
+
+/* Runtime side (rt_d3d9.c). */
+void d3d_vr_attach(const MevrModule *(*attach)(const MevrHostApi *));
+void d3d_vr_d3d9_created(void *host_d3d9);
+uint32_t d3d_vr_pad_get(uint32_t index, uint8_t state[16]); /* rt_dinput.c */
+int d3d_vr_audio(const int16_t *lr, uint32_t frames, uint32_t rate); /* rt_host_*.c audio callback */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
